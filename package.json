{
  "name": "skycart",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create skycart-db",
    "db:migrate:local": "wrangler d1 migrations apply skycart-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply skycart-db --remote",
    "test": "node --check scripts/deploy-cloudflare.mjs && node --test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.155.0"
  }
}
